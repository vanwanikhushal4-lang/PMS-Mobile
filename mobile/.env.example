# Use an HTTPS URL with the deployed SCM context path for shared environments.
# Simulator builds default to the local Tomcat SCM deployment on port 8080.
EXPO_PUBLIC_SCM_URL=https://scm.example.com/SCM/

# Real mobile API supplied by the backend team. No secrets in EXPO_PUBLIC values.
EXPO_PUBLIC_SCM_AUTH_URL=https://scm.example.com/SCM/mobile/v1/auth/
# Development-only client preview. Set 1 to inspect sample data without any backend.
EXPO_PUBLIC_SCM_FRONTEND_PREVIEW=0
